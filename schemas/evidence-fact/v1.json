    "PrevalenceValue": {
      "additionalProperties": false,
      "description": "How widely the subject (a file, an image, a service, a command template) is seen (1.1).",
      "properties": {
        "event_count": {
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "first_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen At"
        },
        "fleet_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The tenant's hosts in scope, when known.",
          "title": "Fleet Size"
        },
        "host_count": {
          "minimum": 0,
          "title": "Host Count",
          "type": "integer"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen At"
        },
        "scope": {
          "description": "tenant_fleet: the tenant's hosts in its telemetry; tenant_alerts: the tenant's alerts.",
          "enum": [
            "tenant_fleet",
            "tenant_alerts"
          ],
          "title": "Scope",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "description": "The window the source actually covered.",
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "window_start",
        "window_end",
        "host_count",
        "event_count"
      ],
      "title": "PrevalenceValue",
      "type": "object"
    },
