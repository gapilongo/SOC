        },
        "redactions": {
          "items": {
            "$ref": "#/$defs/Redaction"
          },
          "maxItems": 50,
          "title": "Redactions",
          "type": "array"
        },
        "schema_version": {
          "default": "1.1.0",
          "description": "SemVer of the schema the producer wrote; major 1.",
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
