{
  "$defs": {
    "GroupCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Group",
          "type": "string"
        }
      },
      "required": [
        "group",
        "count"
      ],
      "title": "GroupCount",
      "type": "object"
    },
    "HostActivityFact": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1.1: false when the source cut the result or could not finish it (a timeout, a row cap, a window that had not closed). Only true lets a claim of absence rest on the fact; absent means the source did not say.",
          "title": "Complete"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source's confidence in the observation, 0-1.",
          "title": "Confidence"
        },
        "id": {
          "description": "Stable within an investigation; verdicts cite it.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "host_activity",
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "redactions": {
          "items": {
            "$ref": "#/$defs/Redaction"
          },
          "maxItems": 50,
          "title": "Redactions",
          "type": "array"
        },
        "schema_version": {
          "default": "1.1.0",
          "description": "SemVer of the schema the producer wrote; major 1.",
          "pattern": "^1\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How long after observed_at the fact stays current; absent means no expiry.",
          "title": "Ttl Seconds"
        },
        "value": {
          "$ref": "#/$defs/HostActivityValue"
        }
      },
      "required": [
        "id",
        "subject",
        "observed_at",
        "source",
        "kind",
        "value"
      ],
      "title": "HostActivityFact",
      "type": "object"
    },
    "HostActivityValue": {
      "additionalProperties": false,
      "description": "What a host's detections show over a window around an alert (1.1).",
      "properties": {
        "by_group": {
          "description": "Up to 50 rule groups, most frequent first.",
          "items": {
            "$ref": "#/$defs/GroupCount"
          },
          "maxItems": 50,
          "title": "By Group",
          "type": "array"
        },
        "events": {
          "description": "Up to 50 events, highest level first.",
          "items": {
            "$ref": "#/$defs/HostEvent"
          },
          "maxItems": 50,
          "title": "Events",
          "type": "array"
        },
        "max_level": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The highest rule level in the window, 0-16; absent when there was no event.",
          "title": "Max Level"
        },
        "techniques": {
          "items": {
            "description": "A MITRE ATT&CK technique id.",
            "examples": [
              "T1110.003"
            ],
            "pattern": "^T\\d{4}(\\.\\d{3})?$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Techniques",
          "type": "array"
        },
        "total": {
          "description": "Events in the window.",
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "total"
      ],
      "title": "HostActivityValue",
      "type": "object"
    },
    "HostEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "command_template": {
          "anyOf": [
            {
              "description": "The command line with its variable parts (paths, ids, values) replaced by placeholders.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Template"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "groups": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Groups",
          "type": "array"
        },
        "image_name": {
          "anyOf": [
            {
              "description": "The executable's file name, without its directory.",
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Name"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "required": [
        "at"
      ],
      "title": "HostEvent",
      "type": "object"
    },
