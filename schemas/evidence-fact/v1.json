    "ProcessLineageValue": {
      "additionalProperties": false,
      "description": "The subject process's ancestry, oldest ancestor first, the subject process last.",
      "properties": {
        "chain": {
          "items": {
            "$ref": "#/$defs/ProcessNode"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Chain",
          "type": "array"
        },
        "children": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ProcessNode"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1.1: up to 50 processes the subject process started. Absent: the source did not look.",
          "title": "Children"
        }
      },
      "required": [
        "chain"
      ],
      "title": "ProcessLineageValue",
      "type": "object"
    },
    "ProcessNode": {
      "additionalProperties": false,
      "properties": {
        "command_line": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Line"
        },
        "command_template": {
          "anyOf": [
            {
              "description": "The command line with its variable parts (paths, ids, values) replaced by placeholders.",
              "maxLength": 4096,
