    },
    "LogonFanoutValue": {
      "additionalProperties": false,
      "description": "Logons around one pivot (a source, a user or a target host) over a window (1.1).",
      "properties": {
        "distinct_sources": {
          "minimum": 0,
          "title": "Distinct Sources",
          "type": "integer"
        },
        "distinct_target_hosts": {
          "minimum": 0,
          "title": "Distinct Target Hosts",
          "type": "integer"
        },
        "distinct_target_users": {
          "minimum": 0,
          "title": "Distinct Target Users",
          "type": "integer"
        },
        "failed_users": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Failed Users",
          "type": "array"
        },
        "failures": {
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "family": {
          "enum": [
            "windows",
            "sshd"
          ],
          "title": "Family",
          "type": "string"
        },
        "first_success_after_failure_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds from the first failure to the first success after it; absent when there was none.",
          "title": "First Success After Failure S"
        },
        "lockouts": {
          "minimum": 0,
          "title": "Lockouts",
          "type": "integer"
        },
        "logon_types": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Logon Types",
          "type": "array"
        },
        "pivot": {
          "description": "What the subject is in these logons.",
          "enum": [
            "source_ip",
            "source_host",
            "target_user",
            "target_host"
          ],
          "title": "Pivot",
          "type": "string"
        },
        "source_hosts": {
          "description": "Up to 50 source host names as the client supplied them: a lead, never proof.",
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Source Hosts",
          "type": "array"
        },
        "sources": {
          "description": "Up to 50 source addresses.",
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Sources",
          "type": "array"
        },
        "success_users": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Success Users",
          "type": "array"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "unknown_user_failures": {
          "description": "Failures for a user name that does not exist.",
          "minimum": 0,
          "title": "Unknown User Failures",
          "type": "integer"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "pivot",
        "family",
        "window_start",
        "window_end",
        "failures",
        "successes",
        "lockouts",
        "unknown_user_failures",
        "distinct_target_users",
        "distinct_sources",
        "distinct_target_hosts"
      ],
      "title": "LogonFanoutValue",
      "type": "object"
    },
