{
  "name": "lg-sotf-web",
  "version": "1.2.3",
  "private": true,
  "description": "LG-SOTF analyst web app",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../../docs/openapi.json --default-non-nullable false --output src/api/schema.gen.ts",
    "test": "vitest",
    "test:ci": "vitest run --coverage && node scripts/coverage-floors.mjs",
    "coverage:floors": "node scripts/coverage-floors.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
