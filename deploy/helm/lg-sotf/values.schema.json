      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "useHelmHooks": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "$ref": "#/definitions/replicas"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "containerPort": {
          "$ref": "#/definitions/port"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/list"
        },
        "affinity": {
          "$ref": "#/definitions/object"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/list"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiBaseUrl": {
              "type": "string",
              "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
            },
            "wsUrl": {
              "type": "string",
              "pattern": "^$|^wss?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
            },
            "extraConnectSrc": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(https?|wss?)://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
              }
            },
            "hstsMaxAge": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]{0,9}$",
              "minimum": 0
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
                },
                "clientId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:@/-]{0,255}$"
                },
                "scope": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 ._:/-]{0,512}$"
                },
                "audience": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:/-]{0,512}$"
                },
                "tokenType": {
                  "enum": [
                    "",
                    "access_token",
                    "id_token"
                  ]
                },
                "redirectUri": {
                  "type": "string",
                  "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
                },
                "authorizationEndpoint": {
                  "type": "string",
                  "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
                },
                "tokenEndpoint": {
                  "type": "string",
                  "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
                },
                "endSessionEndpoint": {
                  "type": "string",
                  "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$"
                },
                "label": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 ._()-]{0,80}$"
                }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
