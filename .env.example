# LG-SOTF environment configuration example.
#
# Copy to .env for local use (`make env` does this and fills in fresh random
# secrets). Never commit a real .env. In Kubernetes put secrets in a Secret
# referenced by the Helm chart (secrets.existingSecret, see docs/deployment.md)
# and non-secret settings in chart values.
#
# Precedence (highest first): LG_SOTF_<SECTION>__<KEY> environment variables,
# this .env file (read from the working directory), the YAML file named by
# LG_SOTF_CONFIG_FILE, built-in defaults. Nested keys use a double underscore:
# LG_SOTF_LLM__FAST__MODEL=claude-haiku-4-5. Lists and maps are JSON.
#
# Generate secrets (or run `python scripts/generate_secrets.py`):
#   Fernet encryption key:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   JWT secret / HMAC key / metrics token / passwords:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================================
# General
# =============================================================================
# development | test | staging | production. staging/production run
# settings.assert_safe(): missing or placeholder secrets, the fake LLM, wildcard
# CORS, insecure cookies or the development DB password refuse to start.
LG_SOTF_ENVIRONMENT=development
# Optional YAML layer. It is selected from the process environment (a value in
# this file is honoured by docker compose, which passes it to the containers).
# The compose stack defaults to /app/configs/development.yaml.
# LG_SOTF_CONFIG_FILE=configs/development.yaml

# =============================================================================
# PostgreSQL
# =============================================================================
# Runtime connection used by the api and worker. In a two-role install this is
# the non-owner login role (no BYPASSRLS). DATABASE_URL is honoured when this is
# unset. The docker compose stack sets its own value; this one is for running
# processes on the host.
LG_SOTF_DATABASE__URL=postgresql://soc:soc_dev_password@localhost:5432/soc
# Schema-owner connection for `lg-sotf migrate` and the scheduler (DDL,
# partitions, retention, cross-tenant sweeps). Defaults to database.url.
# LG_SOTF_DATABASE__MIGRATION_URL=postgresql://lgsotf_owner:<password>@localhost:5432/lgsotf
# Login role that `lg-sotf migrate` grants least-privilege runtime access to.
# LG_SOTF_DATABASE__RUNTIME_ROLE=lgsotf_app
LG_SOTF_DATABASE__POOL_MIN=2
LG_SOTF_DATABASE__POOL_MAX=10
LG_SOTF_DATABASE__COMMAND_TIMEOUT_S=30
LG_SOTF_DATABASE__STATEMENT_TIMEOUT_MS=30000
# disable | prefer | require | verify-ca | verify-full (use verify-full in production)
# LG_SOTF_DATABASE__SSL_MODE=verify-full
# LG_SOTF_DATABASE__SSL_ROOT_CERT=/etc/ssl/certs/db-ca.pem

# =============================================================================
# Redis (queue, events, rate limits)
# =============================================================================
# REDIS_URL is honoured when this is unset. Use rediss:// for TLS.
LG_SOTF_REDIS__URL=redis://localhost:6379/0
LG_SOTF_REDIS__KEY_PREFIX=lgsotf
LG_SOTF_REDIS__MAX_CONNECTIONS=64

# =============================================================================
# LLM
# =============================================================================
# anthropic | openai | gemini | fake. "fake" is deterministic and offline (the
# default here so the stack runs without a key); staging/production refuse it
# unless LG_SOTF_LLM__ALLOW_FAKE=true.
LG_SOTF_LLM__PROVIDER=fake
# LG_SOTF_LLM__ALLOW_FAKE=false
# Provider key. ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY are honoured
# as fallbacks for the matching provider.
# LG_SOTF_LLM__API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# LG_SOTF_LLM__BASE_URL=
LG_SOTF_LLM__FAST__MODEL=claude-haiku-4-5
LG_SOTF_LLM__FAST__MAX_TOKENS=1024
LG_SOTF_LLM__FAST__MAX_CONCURRENCY=16
LG_SOTF_LLM__DEEP__MODEL=claude-opus-5-5
LG_SOTF_LLM__DEEP__MAX_TOKENS=16000
LG_SOTF_LLM__DEEP__TIMEOUT_S=300
LG_SOTF_LLM__DEEP__MAX_CONCURRENCY=8
LG_SOTF_LLM__PROMPT_CACHING=true
LG_SOTF_LLM__MAX_INPUT_CHARS=24000
LG_SOTF_LLM__MAX_FIELD_CHARS=2000
LG_SOTF_LLM__MAX_LIST_ITEMS=50
# Tokens per tenant per UTC day; unset for unlimited.
LG_SOTF_LLM__DAILY_TOKEN_BUDGET_PER_TENANT=5000000

# =============================================================================
# Authentication
# =============================================================================
# HS256 signing key for access tokens, at least 32 bytes. Required in
# staging/production. Rotating it logs every user out (docs/operations.md).
# LG_SOTF_AUTH__JWT_SECRET=
LG_SOTF_AUTH__ACCESS_TOKEN_TTL_S=900
LG_SOTF_AUTH__REFRESH_TOKEN_TTL_S=1209600
# Must be true in staging/production (requires HTTPS in front of the API).
LG_SOTF_AUTH__COOKIE_SECURE=false
# LG_SOTF_AUTH__COOKIE_DOMAIN=soc.example.com
# OIDC single sign-on (optional).
# LG_SOTF_AUTH__OIDC_ISSUER=https://login.example.com/
# LG_SOTF_AUTH__OIDC_AUDIENCE=lg-sotf
# LG_SOTF_AUTH__OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# LG_SOTF_AUTH__OIDC_DEFAULT_TENANT=default
# Bootstrap tenant and first admin, created by `lg-sotf migrate` when the tenant has no users.
LG_SOTF_AUTH__BOOTSTRAP_TENANT_ID=default
LG_SOTF_AUTH__BOOTSTRAP_TENANT_NAME=Default
# LG_SOTF_AUTH__BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# LG_SOTF_AUTH__BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# API
# =============================================================================
LG_SOTF_API__HOST=0.0.0.0
LG_SOTF_API__PORT=8000
LG_SOTF_API__PUBLIC_URL=http://localhost:8000
LG_SOTF_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LG_SOTF_API__DOCS_ENABLED=true
# LG_SOTF_API__METRICS_TOKEN=
# (bearer token Prometheus presents to the API /metrics endpoint; leave the line
# commented out rather than empty: an empty token refuses every scrape)
# Proxies whose X-Forwarded-* headers are trusted (IPs or CIDRs, comma separated).
LG_SOTF_API__FORWARDED_ALLOW_IPS=127.0.0.1
LG_SOTF_API__MAX_INGEST_BATCH=500
LG_SOTF_API__RATE_LIMIT_PER_MINUTE=600
LG_SOTF_API__INGEST_RATE_LIMIT_PER_MINUTE=6000
LG_SOTF_API__LOGIN_RATE_LIMIT_PER_MINUTE=20

# =============================================================================
# Worker / scheduler
# =============================================================================
# Concurrent workflow runs per worker process; size LLM max_concurrency to
# match (docs/deployment.md, "Sizing").
LG_SOTF_WORKER__CONCURRENCY=16
LG_SOTF_WORKER__PER_TENANT_CONCURRENCY=8
LG_SOTF_WORKER__MAX_DELIVERIES=5
LG_SOTF_WORKER__VISIBILITY_TIMEOUT_S=1200
LG_SOTF_WORKER__DRAIN_TIMEOUT_S=60
LG_SOTF_SCHEDULER__LEADER_LEASE_S=30
LG_SOTF_SCHEDULER__SLA_SWEEP_INTERVAL_S=60

# =============================================================================
# Security keys
# =============================================================================
# Comma-separated Fernet keys: the first encrypts, all decrypt. Rotate by
# prepending a new key (docs/operations.md). Required in staging/production.
# LG_SOTF_SECURITY__ENCRYPTION_KEYS=
# HMAC-SHA256 key for indicator hashing (at least 16 bytes). Changing it breaks
# correlation with existing sightings. Required in staging/production.
# LG_SOTF_SECURITY__INDICATOR_HMAC_KEY=

# =============================================================================
# Observability
# =============================================================================
LG_SOTF_OBSERVABILITY__LOG_LEVEL=INFO
# json | console
LG_SOTF_OBSERVABILITY__LOG_FORMAT=console
LG_SOTF_OBSERVABILITY__METRICS_ENABLED=true
# OpenTelemetry trace export (OTLP/HTTP), e.g. http://otel-collector:4318
# LG_SOTF_OBSERVABILITY__OTLP_ENDPOINT=
LG_SOTF_OBSERVABILITY__SERVICE_NAME=lg-sotf

# =============================================================================
# Response actions
# =============================================================================
# true forces dry-run for every tenant.
LG_SOTF_RESPONSE__DRY_RUN=true
LG_SOTF_RESPONSE__MAX_ACTIONS_PER_HOUR_PER_TENANT=50
# LG_SOTF_RESPONSE__WEBHOOK_URL=https://soar.example.com/hooks/lg-sotf
# HMAC key for signing webhook requests to the SOAR.
# LG_SOTF_RESPONSE__WEBHOOK_SECRET=

# =============================================================================
# Retention (days)
# =============================================================================
LG_SOTF_RETENTION__ALERTS_DAYS=90
LG_SOTF_RETENTION__EVENTS_DAYS=90
LG_SOTF_RETENTION__AUDIT_DAYS=365
LG_SOTF_RETENTION__INDICATORS_DAYS=30
LG_SOTF_RETENTION__LLM_USAGE_DAYS=400
LG_SOTF_RETENTION__CHECKPOINTS_DAYS=30

# =============================================================================
# docker compose (docker/docker-compose.yml and docker-compose.prod.yml)
# =============================================================================
# Registry mirrors for base images (defaults are Docker Hub names).
# PYTHON_BASE_IMAGE=mirror.gcr.io/library/python:3.11-slim
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
# APP_IMAGE=lg-sotf:dev
# API_PORT=8000
# Development stack database password (the dev default is refused in production).
# POSTGRES_PASSWORD=
# Production-like override (two database roles); all three are required there.
# POSTGRES_SUPERUSER_PASSWORD=
# LGSOTF_OWNER_PASSWORD=
# LGSOTF_APP_PASSWORD=

# =============================================================================
# Variables read by configs/staging.yaml and configs/production.yaml
# (only when LG_SOTF_CONFIG_FILE points at one of them)
# =============================================================================
# DATABASE_URL, REDIS_URL, JWT_SECRET, ENCRYPTION_KEYS, INDICATOR_HMAC_KEY, METRICS_TOKEN, PUBLIC_URL, COOKIE_DOMAIN, BOOTSTRAP_ADMIN_EMAIL,
# BOOTSTRAP_ADMIN_PASSWORD, OIDC_ISSUER, OIDC_AUDIENCE, OIDC_JWKS_URL, OIDC_DEFAULT_TENANT, OTEL_EXPORTER_OTLP_ENDPOINT, RESPONSE_WEBHOOK_URL, RESPONSE_WEBHOOK_SECRET, LLM_FAST_MODEL,
# LLM_DEEP_MODEL, LLM_DAILY_TOKEN_BUDGET_PER_TENANT, DATABASE_SSL_MODE, DATABASE_SSL_ROOT_CERT, DATABASE_POOL_MIN, DATABASE_POOL_MAX, FORWARDED_ALLOW_IPS, LOG_LEVEL, WORKER_CONCURRENCY, RESPONSE_DRY_RUN, VIRUSTOTAL_API_KEY
