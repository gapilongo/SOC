# LG-SOTF environment configuration example. Copy to .env for local use; never
# commit a real .env. In Kubernetes provide these through Secrets/ConfigMaps.
#
# Precedence (highest first): LG_SOTF_<SECTION>__<KEY> variables, .env, the YAML
# file named by LG_SOTF_CONFIG_FILE, built-in defaults. Nested keys use a double
# underscore: LG_SOTF_LLM__FAST__MODEL=claude-haiku-4-5. Lists/maps are JSON.
#
# Generate secrets with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # encryption key
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                               # JWT / HMAC keys

# --- General ----------------------------------------------------------------
# development | test | staging | production (staging/production enforce assert_safe()).
LG_SOTF_ENVIRONMENT=development
# The YAML layer is selected from the process environment only; a value in this
# file is NOT read. Export it in your shell or container spec instead:
#   export LG_SOTF_CONFIG_FILE=configs/development.yaml

# --- PostgreSQL ---------------------------------------------------------------
# DATABASE_URL is honoured when LG_SOTF_DATABASE__URL is not set.
LG_SOTF_DATABASE__URL=postgresql://soc:change-me@localhost:5432/soc
LG_SOTF_DATABASE__POOL_MIN=2
LG_SOTF_DATABASE__POOL_MAX=10
LG_SOTF_DATABASE__STATEMENT_TIMEOUT_MS=30000
# disable | prefer | require | verify-ca | verify-full
# LG_SOTF_DATABASE__SSL_MODE=verify-full
# LG_SOTF_DATABASE__SSL_ROOT_CERT=/etc/ssl/certs/db-ca.pem

# --- Redis --------------------------------------------------------------------
# REDIS_URL is honoured when LG_SOTF_REDIS__URL is not set. Use rediss:// for TLS.
LG_SOTF_REDIS__URL=redis://localhost:6379/0
LG_SOTF_REDIS__KEY_PREFIX=lgsotf

# --- LLM ----------------------------------------------------------------------
# anthropic | openai | gemini | fake (fake is offline and refused in staging/production)
LG_SOTF_LLM__PROVIDER=anthropic
# ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY are honoured as fallbacks.
# LG_SOTF_LLM__API_KEY=
# LG_SOTF_LLM__BASE_URL=
LG_SOTF_LLM__FAST__MODEL=claude-haiku-4-5
LG_SOTF_LLM__FAST__MAX_TOKENS=1024
LG_SOTF_LLM__FAST__MAX_CONCURRENCY=16
LG_SOTF_LLM__DEEP__MODEL=claude-opus-5-5
LG_SOTF_LLM__DEEP__MAX_TOKENS=16000
LG_SOTF_LLM__DEEP__TIMEOUT_S=300
LG_SOTF_LLM__DEEP__MAX_CONCURRENCY=8
LG_SOTF_LLM__PROMPT_CACHING=true
LG_SOTF_LLM__MAX_INPUT_CHARS=24000
LG_SOTF_LLM__MAX_FIELD_CHARS=2000
LG_SOTF_LLM__MAX_LIST_ITEMS=50
# Tokens per tenant per UTC day; unset for unlimited.
LG_SOTF_LLM__DAILY_TOKEN_BUDGET_PER_TENANT=5000000

# --- Authentication -----------------------------------------------------------
# At least 32 bytes. Required in staging/production.
# LG_SOTF_AUTH__JWT_SECRET=
LG_SOTF_AUTH__ACCESS_TOKEN_TTL_S=900
LG_SOTF_AUTH__REFRESH_TOKEN_TTL_S=1209600
# Must be true in staging/production (requires HTTPS).
LG_SOTF_AUTH__COOKIE_SECURE=false
# LG_SOTF_AUTH__OIDC_ISSUER=https://login.example.com/
# LG_SOTF_AUTH__OIDC_AUDIENCE=lg-sotf
# LG_SOTF_AUTH__OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# Created by `lg-sotf migrate` when set.
# LG_SOTF_AUTH__BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# LG_SOTF_AUTH__BOOTSTRAP_ADMIN_PASSWORD=

# --- API ----------------------------------------------------------------------
LG_SOTF_API__HOST=0.0.0.0
LG_SOTF_API__PORT=8000
LG_SOTF_API__PUBLIC_URL=http://localhost:8000
LG_SOTF_API__CORS_ORIGINS=["http://localhost:5173"]
# Bearer token required by the Prometheus /metrics endpoint.
# LG_SOTF_API__METRICS_TOKEN=
LG_SOTF_API__DOCS_ENABLED=true
LG_SOTF_API__FORWARDED_ALLOW_IPS=127.0.0.1

# --- Worker / scheduler -------------------------------------------------------
LG_SOTF_WORKER__CONCURRENCY=16
LG_SOTF_WORKER__PER_TENANT_CONCURRENCY=8
LG_SOTF_WORKER__MAX_DELIVERIES=5
LG_SOTF_SCHEDULER__LEADER_LEASE_S=30

# --- Security -----------------------------------------------------------------
# Comma-separated Fernet keys; the first encrypts, all decrypt (prepend to rotate).
# LG_SOTF_SECURITY__ENCRYPTION_KEYS=
# HMAC key for indicator hashing (at least 16 bytes; changing it breaks correlation history).
# LG_SOTF_SECURITY__INDICATOR_HMAC_KEY=

# --- Observability ------------------------------------------------------------
LG_SOTF_OBSERVABILITY__LOG_LEVEL=INFO
# json | console
LG_SOTF_OBSERVABILITY__LOG_FORMAT=console
LG_SOTF_OBSERVABILITY__METRICS_ENABLED=true
# Enables OpenTelemetry trace export (OTLP/HTTP), e.g. http://otel-collector:4318
# LG_SOTF_OBSERVABILITY__OTLP_ENDPOINT=
LG_SOTF_OBSERVABILITY__SERVICE_NAME=lg-sotf

# --- Response actions ---------------------------------------------------------
# true forces dry-run for every tenant.
LG_SOTF_RESPONSE__DRY_RUN=true
LG_SOTF_RESPONSE__MAX_ACTIONS_PER_HOUR_PER_TENANT=50
# LG_SOTF_RESPONSE__WEBHOOK_URL=https://soar.example.com/hooks/lg-sotf
# LG_SOTF_RESPONSE__WEBHOOK_SECRET=

# --- Retention (days) ---------------------------------------------------------
LG_SOTF_RETENTION__ALERTS_DAYS=90
LG_SOTF_RETENTION__AUDIT_DAYS=365
LG_SOTF_RETENTION__CHECKPOINTS_DAYS=30

# --- Variables read by configs/staging.yaml and configs/production.yaml -------
# DATABASE_URL=postgresql://lgsotf:<password>@db:5432/lgsotf
# REDIS_URL=rediss://:<password>@redis:6379/0
# ANTHROPIC_API_KEY=
# JWT_SECRET=
# ENCRYPTION_KEYS=
# INDICATOR_HMAC_KEY=
# METRICS_TOKEN=
# PUBLIC_URL=https://soc.example.com
# COOKIE_DOMAIN=soc.example.com
# BOOTSTRAP_ADMIN_EMAIL= / BOOTSTRAP_ADMIN_PASSWORD=
# OIDC_ISSUER= / OIDC_AUDIENCE= / OIDC_JWKS_URL= / OIDC_DEFAULT_TENANT=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# RESPONSE_WEBHOOK_URL= / RESPONSE_WEBHOOK_SECRET=
# LLM_FAST_MODEL= / LLM_DEEP_MODEL= / LLM_DAILY_TOKEN_BUDGET_PER_TENANT=
# DATABASE_SSL_MODE= / DATABASE_SSL_ROOT_CERT= / DATABASE_POOL_MIN= / DATABASE_POOL_MAX=
# FORWARDED_ALLOW_IPS= / LOG_LEVEL= / WORKER_CONCURRENCY= / RESPONSE_DRY_RUN=
# VIRUSTOTAL_API_KEY=
