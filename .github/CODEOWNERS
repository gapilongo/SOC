# Paths whose changes need a review by the repository's security owner.
# Effective only with "Require review from Code Owners" enabled in the
# branch protection of main. The last matching line wins, so keep these
# rules at the end if broader rules are ever added above them.

# Guards and supply chain: editing one of these can silently switch off a check
# (bandit and gitleaks baselines, ratchet allowlists, pinned dependencies, CI).
/.github/workflows/                         @gapilongo
/scripts/ci/                                @gapilongo
/requirements.txt                           @gapilongo
/requirements-dev.txt                       @gapilongo
/docker/requirements-build.txt              @gapilongo
/src/lg_front/package.json                  @gapilongo
/src/lg_front/package-lock.json             @gapilongo
/.github/dependabot.yml                     @gapilongo
/pyproject.toml                             @gapilongo
/tests/unit/architecture/                   @gapilongo
/src/lg_front/eslint.config.js              @gapilongo
/src/lg_front/eslint-rules/                 @gapilongo
/src/lg_front/coverage-floors.json          @gapilongo
/src/lg_front/scripts/coverage-floors.mjs   @gapilongo

# A committed MCP server entry decides which program runs with a tester's
# API key and where the key is sent (design threat #5): the entries, the
# test that pins them and the page that tells testers to copy them.
*.mcp.json                                  @gapilongo
/examples/mcp/                              @gapilongo
/tests/unit/examples/test_mcp_example.py    @gapilongo
/docs/mcp.md                                @gapilongo

# The MCP server holds the key and decides what reaches the model.
/src/lg_sotf/mcp/                           @gapilongo

# This file.
/.github/CODEOWNERS                         @gapilongo
